{%- comment -%}
  NorthSurvive · layout/password.liquid
  Shell for the "coming soon" page shown while the store is password protected.
{%- endcomment -%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}" class="no-js">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex">
    {{ 'inter-latin-wght-normal.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
    {% render 'meta-tags' %}
    {% render 'theme-styles' %}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>

  <body class="template-password">
    <main id="MainContent" class="main">
      {{ content_for_layout }}
    </main>
  </body>
</html>
