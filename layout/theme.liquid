{%- comment -%}
  NorthSurvive · layout/theme.liquid
  The HTML "shell" around every page. Shopify inserts each page's content
  where {{ content_for_layout }} is. Header and footer come from the
  section groups in sections/header-group.json and sections/footer-group.json,
  so they stay editable in the theme editor.
{%- endcomment -%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}" class="no-js">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_paper }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
    {%- endif -%}

    {%- comment -%} Preload the two fonts visible above the fold. {%- endcomment -%}
    {{ 'inter-latin-wght-normal.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
    {{ 'inter-tight-latin-wght-normal.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}

    {% render 'meta-tags' %}
    {% render 'theme-styles' %}

    {{ 'base.css' | asset_url | stylesheet_tag }}

    <script>
      document.documentElement.classList.replace('no-js', 'js');
    </script>
    <script src="{{ 'global.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'cart.js' | asset_url }}" defer="defer"></script>

    {{ content_for_header }}
  </head>

  <body class="template-{{ template.name | handle }}{% unless settings.enable_motion %} no-motion{% endunless %}">
    <a class="skip-link" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" class="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {%- comment -%} The side cart. Its settings are in the theme editor. {%- endcomment -%}
    {% section 'cart-drawer' %}
  </body>
</html>
