{%- comment -%}
  NorthSurvive · templates/gift_card.liquid
  The page a customer sees when they open a gift card email.
  It uses no layout, so it loads its own styles.
{%- endcomment -%}
{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex">
    <title>{{ 'gift_card.title' | t }} – {{ shop.name }}</title>
    {% render 'theme-styles' %}
    {{ 'base.css' | asset_url | stylesheet_tag }}
  </head>
  <body>
    <main class="section page-width" style="display: grid; gap: var(--space-5); justify-items: start; max-width: 40rem;">
      <span class="wordmark" style="font-family: var(--font-display); font-weight: 700; letter-spacing: .24em;">{{ shop.name | upcase }}</span>
      <p class="eyebrow">{{ 'gift_card.title' | t }}</p>
      <h1 class="h-display">{{ gift_card.balance | money }}</h1>
      {%- if gift_card.enabled == false or gift_card.expired -%}
        <p class="lead">{{ 'gift_card.expired' | t }}</p>
      {%- elsif gift_card.expires_on -%}
        {%- assign expires_on_date = gift_card.expires_on | date: '%Y-%m-%d' -%}
        <p class="muted">{{ 'gift_card.expires_on' | t: expires_on: expires_on_date }}</p>
      {%- endif -%}
      <p>{{ 'gift_card.use_code' | t }}</p>
      <p style="font-family: var(--font-mono); font-size: 1.5rem; letter-spacing: .08em; padding: 1rem 1.25rem; border: 1px solid var(--color-line); border-radius: 6px; background: var(--color-white);">{{ gift_card.code | format_code }}</p>
      {%- if gift_card.pass_url -%}
        <a href="{{ gift_card.pass_url }}">
          <img src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}" alt="{{ 'gift_card.apple_wallet' | t }}" width="200" height="60">
        </a>
      {%- endif -%}
      <a href="{{ shop.url }}" class="button">{{ 'gift_card.shop' | t }}</a>
    </main>
  </body>
</html>
