  },
  {
    "name": "Brand colors",
    "settings": [
      {
        "type": "paragraph",
        "content": "The NorthSurvive palette. Change these only if the brand changes. Orange (Signal) is reserved for small accents."
      },
      {
        "type": "color",
        "id": "color_paper",
        "label": "Paper (page background)",
        "default": "#F7F7F5"
      },
      {
        "type": "color",
        "id": "color_white",
        "label": "White (product plates, cards)",
        "default": "#FFFFFF"
      },
      {
        "type": "color",
        "id": "color_ink",
        "label": "Ink (text, primary buttons)",
        "default": "#202326"
      },
      {
        "type": "color",
        "id": "color_graphite",
        "label": "Graphite (dark sections, footer)",
        "default": "#22272B"
      },
      {
        "type": "color",
        "id": "color_stone",
        "label": "Stone (secondary text)",
        "default": "#62676B"
      },
      {
        "type": "color",
        "id": "color_line",
        "label": "Line (borders)",
        "default": "#E4E5E3"
      },
      {
        "type": "color",
        "id": "color_signal",
        "label": "Signal (orange accent)",
        "default": "#E87532"
      },
      {
        "type": "color",
        "id": "color_signal_deep",
        "label": "Signal deep (orange text on light backgrounds)",
        "default": "#B85418"
      }
    ]
  },
  {
    "name": "Logo and favicon",
    "settings": [
      {
        "type": "text",
        "id": "wordmark",
        "label": "Wordmark text",
        "default": "NorthSurvive",
        "info": "Shown instead of a logo image when no logo is uploaded."
      },
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo (header)",
        "info": "SVG or PNG with transparent background. Without a logo the shop name is shown as a wordmark."
      },
      {
        "type": "image_picker",
        "id": "logo_inverse",
        "label": "Light logo (footer, dark background)"
      },
      {
        "type": "range",
        "id": "logo_width",
        "label": "Logo width (desktop)",
        "min": 80,
        "max": 260,
        "step": 4,
        "unit": "px",
        "default": 160
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon",
        "info": "Square image, at least 64 × 64 px."
      },
      {
        "type": "image_picker",
        "id": "share_image",
        "label": "Default social sharing image",
        "info": "Used when a page has no image of its own. 1200 × 628 px recommended."
      }
    ]
  },
  {
    "name": "Social media",
    "settings": [
      {
        "type": "paragraph",
        "content": "Leave a field empty to hide that link."
      },
      {
        "type": "url",
        "id": "social_instagram",
        "label": "Instagram"
      },
      {
        "type": "url",
        "id": "social_facebook",
        "label": "Facebook"
      },
      {
        "type": "url",
        "id": "social_tiktok",
        "label": "TikTok"
      },
      {
        "type": "url",
        "id": "social_youtube",
        "label": "YouTube"
      },
      {
        "type": "url",
        "id": "social_linkedin",
        "label": "LinkedIn"
      }
    ]
  },
  {
    "name": "Motion",
    "settings": [
      {
        "type": "checkbox",
        "id": "enable_motion",
        "label": "Enable subtle animations",
        "info": "Visitors who prefer reduced motion never see animations, whatever this setting.",
        "default": true
      }
    ]
  }
