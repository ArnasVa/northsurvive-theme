{% doc %}
  Renders one of the theme's line icons as inline SVG.
  Icons are decorative: always pair them with visible text or a
  visually-hidden label on the button or link.

  @param {string} name - menu, close, search, account, cart, chevron-down, arrow-right, plus, minus, truck, return, mail
  @param {string} [class] - Optional extra class

  @example
  {% render 'icon', name: 'search' %}
{% enddoc %}
<svg class="icon icon--{{ name }} {{ class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {%- case name -%}
    {%- when 'menu' -%}
      <path d="M4 8h16M4 16h16"/>
    {%- when 'close' -%}
      <path d="m6 6 12 12M18 6 6 18"/>
    {%- when 'search' -%}
      <circle cx="11" cy="11" r="6.5"/><path d="m16 16 4.5 4.5"/>
    {%- when 'account' -%}
      <circle cx="12" cy="8.5" r="3.8"/><path d="M4.5 20c1.3-3.6 4.1-5.4 7.5-5.4s6.2 1.8 7.5 5.4"/>
    {%- when 'cart' -%}
      <path d="M5 8h14l-1.2 12H6.2L5 8Z"/><path d="M9 8V6.5a3 3 0 0 1 6 0V8"/>
    {%- when 'chevron-down' -%}
      <path d="m7 10 5 5 5-5"/>
    {%- when 'arrow-right' -%}
      <path d="M5 12h14M13 6l6 6-6 6"/>
    {%- when 'plus' -%}
      <path d="M12 5v14M5 12h14"/>
    {%- when 'minus' -%}
      <path d="M5 12h14"/>
    {%- when 'truck' -%}
      <path d="M3 7h11v9H3zM14 10h4l3 3v3h-7"/><circle cx="7" cy="17.5" r="1.6"/><circle cx="17.5" cy="17.5" r="1.6"/>
    {%- when 'return' -%}
      <path d="M4 12a8 8 0 1 0 2.4-5.7M4 4v4h4"/>
    {%- when 'check' -%}
      <path d="m5 12.5 4.5 4.5L19 7.5"/>
    {%- when 'mail' -%}
      <path d="M4 6h16v12H4z"/><path d="m4 7 8 6 8-6"/>
  {%- endcase -%}
</svg>
