{% doc %}
  The NorthSurvive product card: white plate, real product image (second
  image fades in on hover), brand, title, Spec Line, real price and stock.
  Everything comes from Shopify; nothing is hard-coded.

  Spec Line: filled from the product metafield `custom.spec_line`
  (type: list of single line text, max 3 values, e.g. "600 lm", "IP66").
  If the metafield is empty the line is simply not shown.

  @param {product} product - The product to show
  @param {boolean} [show_quick_add] - Show an add-to-cart button under the card
  @param {string} [sizes] - The `sizes` attribute for the image
  @param {boolean} [eager] - Load the image eagerly (above the fold)

  @example
  {% render 'product-card', product: product, show_quick_add: true %}
{% enddoc %}
{%- liquid
  assign card_sizes = sizes | default: '(min-width: 1100px) 25vw, (min-width: 700px) 33vw, 50vw'
  assign loading = 'lazy'
  if eager
    assign loading = 'eager'
  endif

  assign show_vendor = true
  assign vendor_handle = product.vendor | handle
  assign shop_handle = shop.name | handle
  if product.vendor == blank or vendor_handle == shop_handle
    assign show_vendor = false
  endif

  assign first_variant = product.selected_or_first_available_variant
  assign image_alt = product.featured_media.alt | default: product.title
  assign min_price = product.price_min | money
  assign is_new = false
  if product.tags contains 'naujiena' or product.tags contains 'Naujiena'
    assign is_new = true
  endif
-%}

<article class="product-card{% unless product.available %} product-card--sold-out{% endunless %}">
  <a href="{{ product.url }}" class="product-card__link" tabindex="-1" aria-hidden="true">
    <div class="product-card__plate">
      {%- if product.featured_media -%}
        {{
          product.featured_media.preview_image
          | image_url: width: 900
          | image_tag:
            class: 'product-card__image',
            loading: loading,
            widths: '300, 450, 600, 900',
            sizes: card_sizes,
            alt: image_alt
        }}
        {%- if product.media.size > 1 and product.media[1].media_type == 'image' -%}
          {{
            product.media[1].preview_image
            | image_url: width: 900
            | image_tag:
              class: 'product-card__image product-card__image--hover',
              loading: 'lazy',
              widths: '300, 450, 600, 900',
              sizes: card_sizes,
              alt: ''
          }}
        {%- endif -%}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}

      {%- if product.available == false -%}
        <span class="badge product-card__badge">{{ 'products.sold_out' | t }}</span>
      {%- elsif product.compare_at_price > product.price -%}
        <span class="badge product-card__badge">{{ 'products.sale' | t }}</span>
      {%- elsif is_new -%}
        <span class="badge product-card__badge">{{ 'products.new' | t }}</span>
      {%- endif -%}
    </div>
  </a>

  <div class="product-card__info">
    {%- if show_vendor -%}
      <p class="eyebrow">{{ product.vendor | escape }}</p>
    {%- endif -%}
    <h3 class="product-card__title">
      <a href="{{ product.url }}">{{ product.title | escape }}</a>
    </h3>

    {%- assign spec_values = product.metafields.custom.spec_line.value -%}
    {%- if spec_values != blank -%}
      <p class="spec-line">
        {%- for spec in spec_values limit: 3 -%}
          <span>{{ spec | escape }}</span>
        {%- endfor -%}
      </p>
    {%- endif -%}

    <div class="product-card__footer">
      <p class="product-card__price">
        {%- if product.price_varies -%}
          {{ 'products.from_price_html' | t: price: min_price }}
        {%- else -%}
          {{ product.price | money }}
        {%- endif -%}
        {%- if product.compare_at_price > product.price -%}
          <s class="product-card__compare">
            <span class="visually-hidden">{{ 'products.regular_price' | t }}</span>
            {{ product.compare_at_price | money }}
          </s>
        {%- endif -%}
      </p>
      {%- if product.available -%}
        <span class="availability">{{ 'products.in_stock' | t }}</span>
      {%- else -%}
        <span class="availability availability--sold-out">{{ 'products.sold_out' | t }}</span>
      {%- endif -%}
    </div>

    {%- if show_quick_add -%}
      {%- if product.available and product.has_only_default_variant -%}
        {%- form 'product', product, class: 'product-card__form' -%}
          <input type="hidden" name="id" value="{{ first_variant.id }}">
          <button type="submit" class="button button--secondary button--small button--full">
            {{ 'products.add_to_cart' | t }}
          </button>
        {%- endform -%}
      {%- elsif product.available -%}
        <a href="{{ product.url }}" class="button button--secondary button--small button--full product-card__form">
          {{ 'products.choose_options' | t }}
        </a>
      {%- endif -%}
    {%- endif -%}
  </div>
</article>
