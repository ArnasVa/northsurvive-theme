{%- comment -%}
  NorthSurvive · snippets/meta-tags.liquid
  Page title, description, canonical URL, social sharing tags and
  structured data. All text comes from Shopify (product, collection and
  page SEO fields), so nothing here needs editing for normal SEO work.
{%- endcomment -%}
{%- liquid
  assign og_title = page_title | default: shop.name
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = page_description | default: shop.description | default: shop.name
  assign og_image = page_image | default: settings.share_image

  case request.page_type
    when 'product'
      assign og_type = 'product'
    when 'article'
      assign og_type = 'article'
    when 'password'
      assign og_url = request.origin
  endcase
-%}

<title>
  {{- page_title -}}
  {%- if current_tags %} – {{ current_tags | join: ', ' }}{% endif -%}
  {%- if current_page != 1 %} – {{ 'general.page_number' | t: page: current_page }}{% endif -%}
  {%- unless page_title contains shop.name %} – {{ shop.name }}{% endunless -%}
</title>

{%- if page_description -%}
  <meta name="description" content="{{ page_description | escape }}">
{%- endif -%}
<link rel="canonical" href="{{ canonical_url }}">

<meta property="og:site_name" content="{{ shop.name }}">
<meta property="og:url" content="{{ og_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ og_description | escape }}">
<meta property="og:locale" content="lt_LT">
{%- if og_image -%}
  <meta property="og:image" content="https:{{ og_image | image_url: width: 1200 }}">
  <meta property="og:image:secure_url" content="https:{{ og_image | image_url: width: 1200 }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="{{ 1200 | divided_by: og_image.aspect_ratio | round }}">
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <meta property="og:price:amount" content="{{ product.price | money_without_currency | strip_html }}">
  <meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
  <script type="application/ld+json">
    {{ product | structured_data }}
  </script>
{%- endif -%}

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_description | escape }}">

{%- if request.page_type == 'index' -%}
  {%- liquid
    assign same_as = ''
    if settings.social_instagram != blank
      assign same_as = same_as | append: '"' | append: settings.social_instagram | append: '",'
    endif
    if settings.social_facebook != blank
      assign same_as = same_as | append: '"' | append: settings.social_facebook | append: '",'
    endif
    if settings.social_tiktok != blank
      assign same_as = same_as | append: '"' | append: settings.social_tiktok | append: '",'
    endif
    if settings.social_youtube != blank
      assign same_as = same_as | append: '"' | append: settings.social_youtube | append: '",'
    endif
    if settings.social_linkedin != blank
      assign same_as = same_as | append: '"' | append: settings.social_linkedin | append: '",'
    endif
    assign same_as_size = same_as | size | minus: 1
    if same_as_size > 0
      assign same_as = same_as | slice: 0, same_as_size
    endif
  -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          "@id": {{ request.origin | append: '/#organization' | json }},
          "name": {{ shop.name | json }},
          "url": {{ request.origin | json }}
          {%- if settings.logo -%},
            "logo": {{ settings.logo | image_url: width: 600 | prepend: 'https:' | json }}
          {%- endif -%}
          {%- if same_as != blank -%},
            "sameAs": [{{ same_as }}]
          {%- endif %}
        },
        {
          "@type": "WebSite",
          "name": {{ shop.name | json }},
          "url": {{ request.origin | json }},
          "publisher": { "@id": {{ request.origin | append: '/#organization' | json }} },
          "potentialAction": {
            "@type": "SearchAction",
            "target": {{ request.origin | append: routes.search_url | append: '?q={search_term_string}' | json }},
            "query-input": "required name=search_term_string"
          }
        }
      ]
    }
  </script>
{%- endif -%}
