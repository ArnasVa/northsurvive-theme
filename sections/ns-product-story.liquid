{%- comment -%}
  NorthSurvive · sections/ns-product-story.liquid
  Visual marketing banners on product pages: photo + text banners,
  full-width photo banners and big "number" highlights (e.g. 600 lm).

  Each block chooses where it appears:
  - "Show on these products": pick one or more products, and/or
  - "…or on all products in this collection": e.g. every NITECORE product.
  On other products the block is not shown, so one section serves every
  product page and everything is edited here in the theme editor.

  Images: upload an editorial photo, or use one of the product's own photos
  ("Use product photo number"). Only write facts that are true for the product.
{%- endcomment -%}
{%- liquid
  assign product_collection_ids = product.collections | map: 'id'
  assign visible = 0
  capture story_blocks
    for block in section.blocks
      assign show = false
      for p in block.settings.products
        if p.id == product.id
          assign show = true
          break
        endif
      endfor
      if show == false and block.settings.collection != blank
        if product_collection_ids contains block.settings.collection.id
          assign show = true
        endif
      endif
      if show
        assign visible = visible | plus: 1
        render 'product-story-block', block: block, product: product
      endif
    endfor
  endcapture
-%}

{%- if visible > 0 -%}
  {{ 'section-product-story.css' | asset_url | stylesheet_tag }}
  <div class="product-story">{{ story_blocks }}</div>
{%- elsif request.design_mode and section.blocks.size == 0 -%}
  <div class="page-width section--tight">
    <p class="muted">{{ 'sections.product_story.empty_editor' | t }}</p>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "NS · Product story",
  "tag": "div",
  "max_blocks": 50,
  "settings": [
    { "type": "paragraph", "content": "Add banners and pick the products (or a collection) each one belongs to." }
  ],
  "blocks": [
    {
      "type": "image_text",
      "name": "Photo + text",
      "settings": [
        { "type": "product_list", "id": "products", "label": "Show on these products", "limit": 50 },
        { "type": "collection", "id": "collection", "label": "…or on all products in this collection" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "range", "id": "media_index", "label": "Or use product photo number", "min": 1, "max": 10, "step": 1, "default": 2, "info": "Used when no image is uploaded above." },
        { "type": "select", "id": "image_position", "label": "Photo position", "options": [ { "value": "left", "label": "Left" }, { "value": "right", "label": "Right" } ], "default": "left" },
        { "type": "select", "id": "color", "label": "Background", "options": [ { "value": "paper", "label": "Paper" }, { "value": "white", "label": "White" }, { "value": "graphite", "label": "Graphite" } ], "default": "white" },
        { "type": "text", "id": "eyebrow", "label": "Small label" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Antraštė" },
        { "type": "richtext", "id": "text", "label": "Text" }
      ]
    },
    {
      "type": "full_banner",
      "name": "Full-width photo",
      "settings": [
        { "type": "product_list", "id": "products", "label": "Show on these products", "limit": 50 },
        { "type": "collection", "id": "collection", "label": "…or on all products in this collection" },
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Wide photo, at least 2000 px." },
        { "type": "range", "id": "media_index", "label": "Or use product photo number", "min": 1, "max": 10, "step": 1, "default": 3 },
        { "type": "text", "id": "eyebrow", "label": "Small label" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Antraštė" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    },
    {
      "type": "highlights",
      "name": "Key numbers",
      "settings": [
        { "type": "product_list", "id": "products", "label": "Show on these products", "limit": 50 },
        { "type": "collection", "id": "collection", "label": "…or on all products in this collection" },
        { "type": "text", "id": "eyebrow", "label": "Small label" },
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "text", "id": "value_1", "label": "Number 1", "info": "For example 600 lm" },
        { "type": "text", "id": "label_1", "label": "Label 1" },
        { "type": "text", "id": "value_2", "label": "Number 2" },
        { "type": "text", "id": "label_2", "label": "Label 2" },
        { "type": "text", "id": "value_3", "label": "Number 3" },
        { "type": "text", "id": "label_3", "label": "Label 3" },
        { "type": "text", "id": "value_4", "label": "Number 4" },
        { "type": "text", "id": "label_4", "label": "Label 4" }
      ]
    }
  ],
  "enabled_on": { "templates": ["product"] },
  "presets": [{ "name": "NS · Product story" }]
}
{% endschema %}
