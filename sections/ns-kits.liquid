{%- comment -%}
  NorthSurvive · sections/ns-kits.liquid
  Preparedness kits as large cards with real products, prices and stock.
  Built to grow: any number of kits.

  Source (setting):
  - "Collection" (recommended): every kit in the chosen collection is shown
    automatically, in the collection's sort order. A new kit appears as soon
    as it is added to the collection. Kit blocks are then optional
    overrides: a block for the same product sets its display title,
    summary and "Rinkinyje" list.
  - "Chosen kits": only the kit blocks, in block order.

  Nothing renders on the live store while there are no kits to show.
{%- endcomment -%}
{%- liquid
  assign source = section.settings.source
  assign collection = section.settings.collection
  assign limit = section.settings.kits_to_show
  assign kit_count = 0

  if source == 'collection' and collection != blank
    assign kit_count = collection.products_count
  else
    assign source = 'blocks'
    for block in section.blocks
      if block.settings.product != blank
        assign kit_count = kit_count | plus: 1
      endif
    endfor
  endif
-%}

{%- if kit_count > 0 -%}
  {{ 'section-kits.css' | asset_url | stylesheet_tag }}

  <section class="section kits" id="rinkiniai" aria-labelledby="KitsHeading-{{ section.id }}">
    <div class="page-width">
      <div class="section-head">
        <div>
          {%- if section.settings.eyebrow != blank -%}
            <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}
          <h2 id="KitsHeading-{{ section.id }}" class="section-head__title">{{ section.settings.heading | escape }}</h2>
        </div>
        <div class="kits__head-aside">
          {%- if section.settings.text != blank -%}
            <p class="section-head__text">{{ section.settings.text | escape }}</p>
          {%- endif -%}
          {%- if source == 'collection' and kit_count > limit and section.settings.all_label != blank -%}
            <a href="{{ collection.url }}" class="text-link">
              {{ section.settings.all_label | escape }}
              {% render 'icon', name: 'arrow-right' %}
            </a>
          {%- endif -%}
        </div>
      </div>

      <ul class="kits__grid kits__grid--{% if kit_count > limit %}{{ limit }}{% else %}{{ kit_count }}{% endif %}" role="list">
        {%- if source == 'collection' -%}
          {%- for product in collection.products limit: limit -%}
            {%- liquid
              assign override = nil
              for block in section.blocks
                if block.settings.product.id == product.id
                  assign override = block
                  break
                endif
              endfor
            -%}
            <li class="kits__item" {% if override %}{{ override.shopify_attributes }}{% endif %}>
              {%- render 'kit-card',
                product: product,
                index: forloop.index,
                title: override.settings.title,
                summary: override.settings.summary,
                contents: override.settings.contents,
                number_label: section.settings.number_label,
                view_label: section.settings.view_label,
                contents_label: section.settings.contents_label,
                show_contents: section.settings.show_contents,
                summary_words: section.settings.summary_words
              -%}
            </li>
          {%- endfor -%}
        {%- else -%}
          {%- assign index = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.settings.product != blank and index < limit -%}
              {%- assign index = index | plus: 1 -%}
              <li class="kits__item" {{ block.shopify_attributes }}>
                {%- render 'kit-card',
                  product: block.settings.product,
                  index: index,
                  title: block.settings.title,
                  summary: block.settings.summary,
                  contents: block.settings.contents,
                  number_label: section.settings.number_label,
                  view_label: section.settings.view_label,
                  contents_label: section.settings.contents_label,
                  show_contents: section.settings.show_contents,
                  summary_words: section.settings.summary_words
                -%}
              </li>
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
      </ul>
    </div>
  </section>
{%- elsif request.design_mode -%}
  <div class="page-width section--tight">
    <p class="muted">{{ 'sections.kits.empty_editor' | t }}</p>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "NS · Kits",
  "tag": "div",
  "max_blocks": 24,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Pasiruošimo komplektai" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Pasiruošimas. Apgalvotas už jus." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Praktiški įrangos deriniai, padedantys pasiruošti svarbiausioms situacijoms." },
    { "type": "text", "id": "number_label", "label": "Number label", "default": "Rinkinys", "info": "Shown above each title as \"Rinkinys 01\". Leave empty to hide." },
    { "type": "header", "content": "Kit cards" },
    { "type": "range", "id": "summary_words", "label": "Summary length (words)", "min": 0, "max": 30, "step": 2, "default": 14, "info": "0 hides the summary. A summary written in a block is always shown in full." },
    { "type": "checkbox", "id": "show_contents", "label": "Show kit contents list", "default": false, "info": "Lists the products in each kit. Off keeps the cards short." },
    { "type": "text", "id": "contents_label", "label": "Contents heading", "default": "Rinkinyje" },
    { "type": "text", "id": "view_label", "label": "Link label", "default": "Žiūrėti rinkinį" },
    { "type": "header", "content": "Which kits to show" },
    {
      "type": "select",
      "id": "source",
      "label": "Source",
      "options": [
        { "value": "collection", "label": "All kits from a collection (automatic)" },
        { "value": "blocks", "label": "Only kits I choose (kit blocks)" }
      ],
      "default": "collection"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Kits collection",
      "info": "Order follows the collection's sort order (Products › Collections › Sort)."
    },
    { "type": "range", "id": "kits_to_show", "label": "Maximum kits shown", "min": 2, "max": 12, "step": 1, "default": 6 },
    { "type": "text", "id": "all_label", "label": "\"All kits\" link label", "default": "Visi rinkiniai", "info": "Shown when the collection has more kits than the maximum." },
    { "type": "paragraph", "content": "Kit blocks: with the collection source they are optional overrides (title, summary, contents) for the same product." }
  ],
  "blocks": [
    {
      "type": "kit",
      "name": "Kit",
      "settings": [
        { "type": "product", "id": "product", "label": "Kit product" },
        { "type": "text", "id": "title", "label": "Display title", "info": "Leave empty to use the product title." },
        { "type": "textarea", "id": "summary", "label": "Short summary", "info": "One or two calm sentences. Leave empty to use the product description." },
        { "type": "textarea", "id": "contents", "label": "Komplekte (one item per line)", "info": "Only list what is really in the kit." }
      ]
    }
  ],
  "presets": [{ "name": "NS · Kits" }]
}
{% endschema %}
