{%- comment -%} NorthSurvive · sections/main-password.liquid — the "opening soon" page {%- endcomment -%}
<section class="section page-width" style="min-height: 80vh; display: grid; align-content: center; gap: var(--space-5); justify-items: start;">
  <span class="wordmark" style="font-family: var(--font-display); font-weight: 700; letter-spacing: .24em;">{{ shop.name | upcase }}</span>
  <h1 class="h-display" style="max-width: 12ch;">{{ section.settings.heading | escape }}</h1>
  {%- if shop.password_message != blank -%}<p class="lead">{{ shop.password_message }}</p>{%- endif -%}
  {%- form 'storefront_password', class: 'basic-search' -%}
    <label for="PasswordInput" class="visually-hidden">{{ 'password.label' | t }}</label>
    <input id="PasswordInput" class="field__input" type="password" name="password" autocomplete="current-password" placeholder="{{ 'password.label' | t }}">
    <button type="submit" class="button">{{ 'password.enter' | t }}</button>
    {%- if form.errors -%}<p class="form-message form-message--error" role="alert">{{ 'password.error' | t }}</p>{%- endif -%}
  {%- endform -%}
</section>

{% schema %}
{
  "name": "Password page",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Netrukus atsidarome." },
    { "type": "paragraph", "content": "The message under the heading is set in Online Store › Preferences › Password protection." }
  ]
}
{% endschema %}
