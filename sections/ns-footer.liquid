{%- comment -%}
  NorthSurvive · sections/ns-footer.liquid
  Graphite footer: brand statement, optional newsletter, up to four menu
  columns (blocks), a text column for contact details, social links,
  policies and payment icons. Contact and company details are never
  hard-coded: add them in the theme editor.
{%- endcomment -%}
{{ 'section-footer.css' | asset_url | stylesheet_tag }}

<footer class="site-footer section--dark">
  <div class="page-width site-footer__top">
    <div class="site-footer__brand">
      {%- if settings.logo_inverse != blank -%}
        {{
          settings.logo_inverse
          | image_url: width: 480
          | image_tag: class: 'site-footer__logo', loading: 'lazy', alt: shop.name, widths: '160, 320, 480'
        }}
      {%- else -%}
        <span class="wordmark">{{ shop.name | upcase }}</span>
      {%- endif -%}

      {%- if section.settings.statement != blank -%}
        <p class="site-footer__statement">{{ section.settings.statement | escape }}</p>
      {%- endif -%}

      {%- if section.settings.show_newsletter -%}
        {%- form 'customer', id: 'FooterNewsletter', class: 'newsletter' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <label for="FooterNewsletterEmail" class="newsletter__label">
            {%- liquid
              assign newsletter_label = section.settings.newsletter_text
              if newsletter_label == blank
                assign newsletter_label = 'footer.newsletter_label' | t
              endif
            -%}
            {{- newsletter_label | escape -}}
          </label>
          <div class="newsletter__row">
            <input
              id="FooterNewsletterEmail"
              class="newsletter__input"
              type="email"
              name="contact[email]"
              autocomplete="email"
              autocorrect="off"
              autocapitalize="off"
              placeholder="{{ 'footer.email_placeholder' | t }}"
              required
              {% if form.errors %}
                aria-invalid="true" aria-describedby="FooterNewsletterMessage"
              {% endif %}
            >
            <button type="submit" class="button button--light">{{ 'footer.subscribe' | t }}</button>
          </div>
          {%- if form.errors -%}
            <p id="FooterNewsletterMessage" class="form-message form-message--error" role="alert">
              {{ 'footer.newsletter_error' | t }}
            </p>
          {%- elsif form.posted_successfully? -%}
            <p class="form-message form-message--success" role="status">{{ 'footer.newsletter_success' | t }}</p>
          {%- endif -%}
        {%- endform -%}
      {%- endif -%}
    </div>

    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'menu' -%}
          {%- if block.settings.menu != blank -%}
            <div class="site-footer__column" {{ block.shopify_attributes }}>
              <h2 class="site-footer__heading">{{ block.settings.heading | default: block.settings.menu.title | escape }}</h2>
              <ul class="site-footer__links" role="list">
                {%- for link in block.settings.menu.links -%}
                  <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}
        {%- when 'text' -%}
          <div class="site-footer__column" {{ block.shopify_attributes }}>
            {%- if block.settings.heading != blank -%}
              <h2 class="site-footer__heading">{{ block.settings.heading | escape }}</h2>
            {%- endif -%}
            <div class="site-footer__text rte">{{ block.settings.text }}</div>
          </div>
      {%- endcase -%}
    {%- endfor -%}
  </div>

  {%- liquid
    assign has_social = false
    if settings.social_instagram != blank or settings.social_facebook != blank or settings.social_tiktok != blank or settings.social_youtube != blank or settings.social_linkedin != blank
      assign has_social = true
    endif
  -%}

  <div class="site-footer__bottom">
    <div class="page-width site-footer__bottom-inner">
      <div class="site-footer__legal">
        <span>© {{ 'now' | date: '%Y' }} {{ shop.name }}</span>
        {%- if section.settings.company_details != blank -%}
          <span>{{ section.settings.company_details | escape }}</span>
        {%- endif -%}
        {%- if shop.policies.size > 0 -%}
          <ul class="site-footer__policies" role="list">
            {%- for policy in shop.policies -%}
              <li><a href="{{ policy.url }}">{{ policy.title | escape }}</a></li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

      <div class="site-footer__meta">
        {%- if has_social -%}
          <ul class="site-footer__social" role="list" aria-label="{{ 'footer.social' | t }}">
            {%- if settings.social_instagram != blank -%}<li><a href="{{ settings.social_instagram }}" rel="noopener">Instagram</a></li>{%- endif -%}
            {%- if settings.social_facebook != blank -%}<li><a href="{{ settings.social_facebook }}" rel="noopener">Facebook</a></li>{%- endif -%}
            {%- if settings.social_tiktok != blank -%}<li><a href="{{ settings.social_tiktok }}" rel="noopener">TikTok</a></li>{%- endif -%}
            {%- if settings.social_youtube != blank -%}<li><a href="{{ settings.social_youtube }}" rel="noopener">YouTube</a></li>{%- endif -%}
            {%- if settings.social_linkedin != blank -%}<li><a href="{{ settings.social_linkedin }}" rel="noopener">LinkedIn</a></li>{%- endif -%}
          </ul>
        {%- endif -%}

        {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
          <ul class="site-footer__payments" role="list" aria-label="{{ 'footer.payment_methods' | t }}">
            {%- for type in shop.enabled_payment_types -%}
              <li>{{ type | payment_type_svg_tag: class: 'payment-icon' }}</li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "section-footer",
  "enabled_on": { "groups": ["footer"] },
  "max_blocks": 5,
  "settings": [
    { "type": "text", "id": "statement", "label": "Brand statement", "default": "Pasiruošimas be baimės." },
    { "type": "header", "content": "Newsletter" },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Show newsletter signup",
      "info": "Subscribers are saved as customers with email marketing consent in Shopify admin.",
      "default": true
    },
    { "type": "text", "id": "newsletter_text", "label": "Newsletter label", "default": "Naujienlaiškis. Retai, tik tai, kas naudinga." },
    { "type": "header", "content": "Bottom bar" },
    {
      "type": "text",
      "id": "company_details",
      "label": "Company details",
      "info": "For example legal name and company code. Shown next to the copyright."
    },
    { "type": "checkbox", "id": "show_payment_icons", "label": "Show payment icons", "default": true }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "info": "Leave empty to use the menu's name." },
        { "type": "link_list", "id": "menu", "label": "Menu" }
      ]
    },
    {
      "type": "text",
      "name": "Text column",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Kontaktai" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Įrašykite savo kontaktus teminiame redaktoriuje.</p>" }
      ]
    }
  ]
}
{% endschema %}
