{%- comment -%}
  NorthSurvive · sections/main-cart.liquid
  The cart page. Same line items as the side cart. Works without
  JavaScript (Atnaujinti button, remove links); assets/cart.js makes
  quantity changes instant. Checkout is Shopify's native checkout.
{%- endcomment -%}
{{ 'component-cart.css' | asset_url | stylesheet_tag }}

<ns-cart class="cart-page page-width" data-section-id="{{ section.id }}">
  <header class="cart-page__head">
    <h1 class="cart-page__title">{{ section.settings.heading | escape }}</h1>
    {%- if cart.item_count > 0 -%}
      <a href="{{ section.settings.continue_link | default: routes.all_products_collection_url }}" class="text-link">{{ section.settings.continue_label | escape }}</a>
    {%- endif -%}
  </header>

  <div data-cart-root>
    {%- if cart.item_count == 0 -%}
      <div class="cart-empty cart-empty--page">
        <p class="cart-empty__heading">{{ section.settings.empty_heading | escape }}</p>
        {%- if section.settings.empty_text != blank -%}<p class="muted">{{ section.settings.empty_text | escape }}</p>{%- endif -%}
        <a href="{{ section.settings.empty_button_link | default: routes.all_products_collection_url }}" class="button">
          {{ section.settings.empty_button_label | escape }}
          {% render 'icon', name: 'arrow-right' %}
        </a>
      </div>
    {%- else -%}
      <form action="{{ routes.cart_url }}" method="post" class="cart-page__grid" id="CartPageForm">
        <div>
          <ul class="cart-items cart-items--page" role="list">
            {%- for item in cart.items -%}
              {% render 'cart-line-item', item: item, line: forloop.index %}
            {%- endfor -%}
          </ul>
          <p class="cart-error small" role="alert" data-cart-error hidden></p>
          <noscript><button type="submit" class="button button--secondary button--small" style="margin-top: 1rem;">{{ 'cart.update' | t }}</button></noscript>
        </div>

        <aside class="cart-page__summary">
          <div class="cart-summary">
            <span>{{ 'cart.subtotal' | t }}</span>
            <span class="cart-summary__total">{{ cart.total_price | money }}</span>
          </div>
          {%- if cart.cart_level_discount_applications.size > 0 -%}
            <ul class="cart-discounts" role="list">
              {%- for discount in cart.cart_level_discount_applications -%}
                <li>{{ discount.title | escape }} (−{{ discount.total_allocated_amount | money }})</li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
          {%- if section.settings.footer_note != blank -%}
            <p class="small muted">{{ section.settings.footer_note | escape }}</p>
          {%- endif -%}
          {%- if section.settings.show_note -%}
            <div class="field cart-page__note">
              <label for="CartNote" class="field__label">{{ section.settings.note_label | escape }}</label>
              <textarea id="CartNote" name="note" class="field__input cart-page__textarea" rows="3">{{ cart.note }}</textarea>
            </div>
          {%- endif -%}
          <button type="submit" name="checkout" class="button button--full">
            {{ 'cart.checkout' | t }}
            {% render 'icon', name: 'arrow-right' %}
          </button>
        </aside>
      </form>
    {%- endif -%}
  </div>
</ns-cart>

{% schema %}
{
  "name": "Cart page",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Krepšelis" },
    { "type": "text", "id": "continue_label", "label": "\"Continue shopping\" label", "default": "Tęsti apsipirkimą" },
    { "type": "url", "id": "continue_link", "label": "\"Continue shopping\" link" },
    { "type": "text", "id": "footer_note", "label": "Note under the total", "default": "Pristatymo kaina apskaičiuojama atsiskaitant." },
    { "type": "checkbox", "id": "show_note", "label": "Show order note field", "default": false },
    { "type": "text", "id": "note_label", "label": "Order note label", "default": "Pastaba užsakymui" },
    { "type": "header", "content": "Empty cart" },
    { "type": "text", "id": "empty_heading", "label": "Heading", "default": "Krepšelis kol kas tuščias." },
    { "type": "text", "id": "empty_text", "label": "Text", "default": "Pradėkite nuo rinkinio arba pasirinkite atskirus produktus." },
    { "type": "text", "id": "empty_button_label", "label": "Button label", "default": "Atrasti produktus" },
    { "type": "url", "id": "empty_button_link", "label": "Button link" }
  ]
}
{% endschema %}
