{%- comment -%}
  NorthSurvive · sections/main-search.liquid
  The full search results page: products as product cards, then matching
  articles and pages. Text above the results is editable in the theme editor.
{%- endcomment -%}
{{ 'component-product-card.css' | asset_url | stylesheet_tag }}
{{ 'component-search.css' | asset_url | stylesheet_tag }}
{{ 'section-main-collection.css' | asset_url | stylesheet_tag }}

<section class="search-page page-width">
  <header class="search-page__head">
    <h1 class="search-page__title">{{ section.settings.heading | escape }}</h1>
    <form action="{{ routes.search_url }}" method="get" role="search" class="search-page__form">
      <label for="SearchPageInput" class="visually-hidden">{{ 'search.label' | t }}</label>
      <input id="SearchPageInput" class="field__input" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'search.placeholder' | t }}">
      <input type="hidden" name="options[prefix]" value="last">
      <button type="submit" class="button">{{ 'search.submit' | t }}</button>
    </form>
    {%- if search.performed -%}
      <p class="search-page__count">{{ 'search.results_count' | t: count: search.results_count, terms: search.terms }}</p>
    {%- endif -%}
  </header>

  {%- if search.performed -%}
    {%- paginate search.results by section.settings.per_page -%}
      {%- liquid
        assign product_count = 0
        assign other_count = 0
        for result in search.results
          if result.object_type == 'product'
            assign product_count = product_count | plus: 1
          else
            assign other_count = other_count | plus: 1
          endif
        endfor
      -%}

      {%- if search.results_count == 0 -%}
        <div class="search-page__empty">
          <p class="lead">{{ section.settings.empty_text | escape }}</p>
          {%- if section.settings.empty_button_label != blank -%}
            <a href="{{ section.settings.empty_button_link | default: routes.collections_url }}" class="button button--secondary">{{ section.settings.empty_button_label | escape }}</a>
          {%- endif -%}
        </div>
      {%- else -%}
        {%- if product_count > 0 -%}
          <h2 class="visually-hidden">{{ 'search.products' | t }}</h2>
          <ul class="product-grid" role="list">
            {%- for result in search.results -%}
              {%- if result.object_type == 'product' -%}
                <li>{% render 'product-card', product: result, show_quick_add: section.settings.show_quick_add %}</li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if other_count > 0 -%}
          <h2 class="search-page__subhead">{{ section.settings.other_heading | escape }}</h2>
          <ul class="search-page__links" role="list">
            {%- for result in search.results -%}
              {%- unless result.object_type == 'product' -%}
                <li>
                  <a href="{{ result.url }}">
                    <span class="eyebrow">
                      {%- case result.object_type -%}
                        {%- when 'article' -%}{{ 'search.type_article' | t }}
                        {%- when 'page' -%}{{ 'search.type_page' | t }}
                        {%- else -%}{{ 'search.type_collection' | t }}
                      {%- endcase -%}
                    </span>
                    <span class="search-page__link-title">{{ result.title | escape }}</span>
                  </a>
                </li>
              {%- endunless -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if paginate.pages > 1 -%}
          {% render 'pagination', paginate: paginate %}
        {%- endif -%}
      {%- endif -%}
    {%- endpaginate -%}
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Search results",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Paieška" },
    { "type": "range", "id": "per_page", "label": "Results per page", "min": 12, "max": 48, "step": 4, "default": 24 },
    { "type": "checkbox", "id": "show_quick_add", "label": "Show add-to-cart buttons", "default": true },
    { "type": "text", "id": "other_heading", "label": "Heading above articles and pages", "default": "Straipsniai ir puslapiai" },
    { "type": "header", "content": "No results" },
    { "type": "text", "id": "empty_text", "label": "Text", "default": "Nieko neradome. Pabandykite kitą žodį arba naršykite kategorijas." },
    { "type": "text", "id": "empty_button_label", "label": "Button label", "default": "Žiūrėti kategorijas" },
    { "type": "url", "id": "empty_button_link", "label": "Button link" }
  ]
}
{% endschema %}
