{%- comment -%}
  NorthSurvive · sections/ns-brand-hero.liquid
  Brand introduction shown above the products on a brand's collection page.
  Add one "Brand" block per brand and pick its collection. On each
  collection page only the matching block is shown; on all other
  collections this section shows nothing. So every brand page is edited
  here, in the theme editor, without separate templates.
  Only write facts you can stand behind: no invented history or awards.
{%- endcomment -%}
{%- liquid
  assign brand = nil
  for block in section.blocks
    if block.settings.collection != blank and block.settings.collection.handle == collection.handle
      assign brand = block
      break
    endif
  endfor
-%}

{%- if brand -%}
  {{ 'section-brand-hero.css' | asset_url | stylesheet_tag }}
  {%- assign brand_image = brand.settings.image | default: collection.featured_image -%}

  <section class="brand-hero" {{ brand.shopify_attributes }}>
    <div class="brand-hero__grid page-width">
      <div class="brand-hero__copy">
        {%- if brand.settings.logo != blank -%}
          {{ brand.settings.logo | image_url: width: 480 | image_tag: class: 'brand-hero__logo', loading: 'eager', alt: collection.title, widths: '240, 360, 480', sizes: '220px' }}
        {%- elsif brand.settings.eyebrow != blank -%}
          <p class="eyebrow">{{ brand.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if brand.settings.heading != blank -%}
          <p class="brand-hero__heading">{{ brand.settings.heading | escape }}</p>
        {%- endif -%}
        {%- if brand.settings.text != blank -%}
          <div class="brand-hero__text rte">{{ brand.settings.text }}</div>
        {%- endif -%}
      </div>
      <div class="brand-hero__media">
        {%- if brand_image != blank -%}
          {%- assign brand_alt = brand_image.alt | default: collection.title -%}
          {{ brand_image | image_url: width: 1600 | image_tag: class: 'brand-hero__image', loading: 'eager', widths: '600, 900, 1200, 1600', sizes: '(min-width: 900px) 50vw, 100vw', alt: brand_alt }}
        {%- else -%}
          <div class="brand-hero__placeholder" aria-hidden="true"></div>
        {%- endif -%}
      </div>
    </div>

    {%- liquid
      assign has_strengths = false
      if brand.settings.strength_1_title != blank or brand.settings.strength_2_title != blank or brand.settings.strength_3_title != blank
        assign has_strengths = true
      endif
    -%}
    {%- if has_strengths -%}
      <div class="page-width">
        <ul class="brand-hero__strengths" role="list">
          {%- if brand.settings.strength_1_title != blank -%}
            <li><p class="brand-hero__strength-title">{{ brand.settings.strength_1_title | escape }}</p><p class="muted">{{ brand.settings.strength_1_text | escape }}</p></li>
          {%- endif -%}
          {%- if brand.settings.strength_2_title != blank -%}
            <li><p class="brand-hero__strength-title">{{ brand.settings.strength_2_title | escape }}</p><p class="muted">{{ brand.settings.strength_2_text | escape }}</p></li>
          {%- endif -%}
          {%- if brand.settings.strength_3_title != blank -%}
            <li><p class="brand-hero__strength-title">{{ brand.settings.strength_3_title | escape }}</p><p class="muted">{{ brand.settings.strength_3_text | escape }}</p></li>
          {%- endif -%}
        </ul>
      </div>
    {%- endif -%}
  </section>
{%- elsif request.design_mode and section.blocks.size == 0 -%}
  <div class="page-width section--tight">
    <p class="muted">{{ 'sections.brand.empty_editor' | t }}</p>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "NS · Brand intro",
  "tag": "div",
  "settings": [
    { "type": "paragraph", "content": "One block per brand. Each block appears only on the collection you pick for it." }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Brand",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Brand collection" },
        { "type": "image_picker", "id": "logo", "label": "Official logo", "info": "The brand's own logo file. Dark on transparent works best." },
        { "type": "text", "id": "eyebrow", "label": "Small label (shown when there is no logo)" },
        { "type": "text", "id": "heading", "label": "Statement" },
        { "type": "richtext", "id": "text", "label": "Why we chose this brand" },
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Without an image, the collection image is used." },
        { "type": "header", "content": "Three strengths (optional)" },
        { "type": "text", "id": "strength_1_title", "label": "Strength 1 title" },
        { "type": "text", "id": "strength_1_text", "label": "Strength 1 text" },
        { "type": "text", "id": "strength_2_title", "label": "Strength 2 title" },
        { "type": "text", "id": "strength_2_text", "label": "Strength 2 text" },
        { "type": "text", "id": "strength_3_title", "label": "Strength 3 title" },
        { "type": "text", "id": "strength_3_text", "label": "Strength 3 text" }
      ]
    }
  ],
  "enabled_on": { "templates": ["collection"] },
  "presets": [{ "name": "NS · Brand intro" }]
}
{% endschema %}
