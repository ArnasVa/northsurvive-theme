{%- comment -%}
  NorthSurvive · sections/ns-about.liquid
  "Atrenkame tai, kuo verta pasikliauti": a large statement, a short
  paragraph and a button, followed by the selection criteria (blocks).
  The criteria should describe how products are really chosen.
{%- endcomment -%}
{%- liquid
  # On page templates this section shows only on the page picked in its settings.
  assign ns_hidden = false
  if template.name == 'page'
    if section.settings.only_page == blank or section.settings.only_page.handle != page.handle
      assign ns_hidden = true
    endif
  endif
-%}
{%- unless ns_hidden -%}
{{ 'section-about.css' | asset_url | stylesheet_tag }}

<section class="section about" aria-labelledby="AboutHeading-{{ section.id }}">
  <div class="page-width">
    <div class="about__intro">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        <h2 id="AboutHeading-{{ section.id }}" class="about__heading">{{ section.settings.heading | escape }}</h2>
      </div>
      <div class="about__aside">
        {%- if section.settings.text != blank -%}
          <div class="about__text">{{ section.settings.text }}</div>
        {%- endif -%}
        {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
          <a href="{{ section.settings.button_link }}" class="button button--secondary">
            {{ section.settings.button_label | escape }}
            {% render 'icon', name: 'arrow-right' %}
          </a>
        {%- endif -%}
      </div>
    </div>

    {%- if section.blocks.size > 0 -%}
      <ul class="about__criteria" role="list">
        {%- for block in section.blocks -%}
          <li class="about__criterion" {{ block.shopify_attributes }}>
            {%- if section.settings.criteria_label != blank -%}
              <p class="eyebrow">{{ section.settings.criteria_label | escape }} {{ forloop.index | prepend: '0' }}</p>
            {%- endif -%}
            <h3 class="about__criterion-title">{{ block.settings.title | escape }}</h3>
            {%- if block.settings.text != blank -%}
              <p class="muted">{{ block.settings.text | escape }}</p>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{%- endunless -%}

{% schema %}
{
  "name": "NS · About",
  "tag": "div",
  "max_blocks": 4,
  "settings": [
    { "type": "page", "id": "only_page", "label": "Show on page", "info": "Only used on page templates, e.g. \"Apie mus\". Empty there: the section is hidden." },
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Apie NorthSurvive" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Atrenkame tai, kuo verta pasikliauti." },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>NorthSurvive nėra didelis katalogas. Atrenkame nedaug, bet patikimų dalykų, kurie padeda jaustis ramiau namie, kelyje ir gamtoje. Be triukšmo ir be baimės, tik tai, ko iš tiesų prireikia.</p>"
    },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Daugiau apie mus" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "criteria_label", "label": "Criteria label", "default": "Kriterijus" }
  ],
  "blocks": [
    {
      "type": "criterion",
      "name": "Selection criterion",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Aiški paskirtis" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "NS · About",
      "blocks": [
        { "type": "criterion", "settings": { "title": "Aiški paskirtis", "text": "Kiekvienas produktas sprendžia konkrečią situaciją." } },
        { "type": "criterion", "settings": { "title": "Patikimas gamintojas", "text": "Prekės ženklai su aiškia garantija ir dokumentacija." } },
        { "type": "criterion", "settings": { "title": "Paprasta naudoti", "text": "Įranga, kurią suprasite ir tamsoje, ir skubant." } }
      ]
    }
  ]
}
{% endschema %}
