{%- comment -%}
  NorthSurvive · sections/ns-related-products.liquid
  "Jums gali praversti": Shopify's own product recommendations for the
  current product. The products load after the page (assets/product.js,
  <ns-recommendations>), so the product page itself stays fast.
{%- endcomment -%}
{{ 'component-product-card.css' | asset_url | stylesheet_tag }}

<ns-recommendations
  class="section related"
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.products_to_show }}&intent=related"
>
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    <div class="page-width">
      <div class="section-head">
        <div>
          {%- if section.settings.eyebrow != blank -%}
            <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}
          <h2 class="section-head__title">{{ section.settings.heading | escape }}</h2>
        </div>
      </div>
      <ul class="product-grid" role="list">
        {%- for item in recommendations.products -%}
          <li>{% render 'product-card', product: item, show_quick_add: section.settings.show_quick_add %}</li>
        {%- endfor -%}
      </ul>
    </div>
  {%- endif -%}
</ns-recommendations>

{% schema %}
{
  "name": "Related products",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Taip pat" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Jums gali praversti" },
    { "type": "range", "id": "products_to_show", "label": "Products", "min": 2, "max": 8, "step": 1, "default": 4 },
    { "type": "checkbox", "id": "show_quick_add", "label": "Show add-to-cart buttons", "default": false }
  ],
  "enabled_on": { "templates": ["product"] }
}
{% endschema %}
