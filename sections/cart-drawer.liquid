{%- comment -%}
  NorthSurvive · sections/cart-drawer.liquid
  The side cart. Included once in layout/theme.liquid, so its settings are
  edited in the theme editor on any page (Theme settings area › Cart drawer).
  Opens after "Į krepšelį" and from the header cart icon. Contents always
  come from Shopify's real cart; checkout is Shopify's native checkout.
  Behaviour: assets/cart.js (<ns-cart>).
{%- endcomment -%}
{%- if section.settings.enabled -%}
  {{ 'component-cart.css' | asset_url | stylesheet_tag }}

  <ns-cart class="cart-drawer" data-section-id="{{ section.id }}" data-drawer hidden>
    <div class="cart-drawer__backdrop" data-cart-close></div>
    <div class="cart-drawer__panel" role="dialog" aria-modal="true" aria-labelledby="CartDrawerHeading" tabindex="-1">
      <div class="cart-drawer__top">
        <h2 id="CartDrawerHeading" class="cart-drawer__heading">
          {{ section.settings.heading | escape }}
          <span class="cart-drawer__count" data-cart-drawer-count {% if cart.item_count == 0 %}hidden{% endif %}>{{ cart.item_count }}</span>
        </h2>
        <button type="button" class="icon-button" data-cart-close>
          {% render 'icon', name: 'close' %}
          <span class="visually-hidden">{{ 'cart.close' | t }}</span>
        </button>
      </div>

      <div class="cart-drawer__body" data-cart-root>
        {%- if cart.item_count == 0 -%}
          <div class="cart-empty">
            <p class="cart-empty__heading">{{ section.settings.empty_heading | escape }}</p>
            {%- if section.settings.empty_text != blank -%}
              <p class="muted">{{ section.settings.empty_text | escape }}</p>
            {%- endif -%}
            {%- if section.settings.empty_button_label != blank -%}
              <a href="{{ section.settings.empty_button_link | default: routes.all_products_collection_url }}" class="button">
                {{ section.settings.empty_button_label | escape }}
                {% render 'icon', name: 'arrow-right' %}
              </a>
            {%- endif -%}
          </div>
        {%- else -%}
          {%- liquid
            assign threshold = section.settings.free_shipping_threshold | times: 100
          -%}
          {%- if threshold > 0 -%}
            {%- liquid
              assign remaining = threshold | minus: cart.total_price
              assign progress = cart.total_price | times: 100 | divided_by: threshold
              if progress > 100
                assign progress = 100
              endif
            -%}
            <div class="cart-shipping">
              {%- if remaining > 0 -%}
                {%- assign remaining_money = remaining | money | prepend: '<strong>' | append: '</strong>' -%}
                <p class="small">{{ section.settings.free_shipping_remaining | escape | replace: '[amount]', remaining_money }}</p>
              {%- else -%}
                <p class="small">{{ section.settings.free_shipping_reached | escape }}</p>
              {%- endif -%}
              <div class="cart-shipping__bar" aria-hidden="true"><span style="width: {{ progress }}%"></span></div>
            </div>
          {%- endif -%}

          <ul class="cart-items" role="list">
            {%- for item in cart.items -%}
              {% render 'cart-line-item', item: item, line: forloop.index %}
            {%- endfor -%}
          </ul>

          <p class="cart-error small" role="alert" data-cart-error hidden></p>

          <div class="cart-drawer__footer">
            <div class="cart-summary">
              <span>{{ 'cart.subtotal' | t }}</span>
              <span class="cart-summary__total">{{ cart.total_price | money }}</span>
            </div>
            {%- if section.settings.footer_note != blank -%}
              <p class="small muted">{{ section.settings.footer_note | escape }}</p>
            {%- endif -%}
            <form action="{{ routes.cart_url }}" method="post" class="cart-drawer__checkout">
              <button type="submit" name="checkout" class="button button--full">
                {{ 'cart.checkout' | t }}
                {% render 'icon', name: 'arrow-right' %}
              </button>
            </form>
            <a href="{{ routes.cart_url }}" class="text-link cart-drawer__view">{{ 'cart.view_cart' | t }}</a>
          </div>
        {%- endif -%}
      </div>
    </div>
  </ns-cart>
{%- endif -%}

{% schema %}
{
  "name": "Cart drawer",
  "tag": "div",
  "class": "section-cart-drawer",
  "settings": [
    { "type": "checkbox", "id": "enabled", "label": "Use the side cart", "default": true, "info": "Off: \"Į krepšelį\" shows a message and the cart icon opens the cart page." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Krepšelis" },
    { "type": "text", "id": "footer_note", "label": "Note under the total", "default": "Pristatymo kaina apskaičiuojama atsiskaitant." },
    { "type": "header", "content": "Empty cart" },
    { "type": "text", "id": "empty_heading", "label": "Heading", "default": "Krepšelis kol kas tuščias." },
    { "type": "text", "id": "empty_text", "label": "Text", "default": "Pradėkite nuo rinkinio arba pasirinkite atskirus produktus." },
    { "type": "text", "id": "empty_button_label", "label": "Button label", "default": "Atrasti produktus" },
    { "type": "url", "id": "empty_button_link", "label": "Button link" },
    { "type": "header", "content": "Free delivery progress (optional)" },
    { "type": "number", "id": "free_shipping_threshold", "label": "Free delivery from (€)", "info": "Leave empty or 0 to hide. Must match your real shipping settings." },
    { "type": "text", "id": "free_shipping_remaining", "label": "Message before the threshold", "default": "Iki nemokamo pristatymo trūksta [amount].", "info": "[amount] is replaced with the remaining sum." },
    { "type": "text", "id": "free_shipping_reached", "label": "Message after the threshold", "default": "Jūsų užsakymui pristatymas nemokamas." }
  ]
}
{% endschema %}
