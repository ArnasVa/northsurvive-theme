{%- comment -%}
  NorthSurvive · sections/ns-featured-products.liquid
  "Atrinkta": live products from up to three collections, switched with tabs.
  Each block is one tab = one collection. With a single block the tabs are
  hidden. Without JavaScript all groups are shown one under another.
  Tab behaviour: assets/global.js (<ns-tabs>).
{%- endcomment -%}
{{ 'component-product-card.css' | asset_url | stylesheet_tag }}
{{ 'section-featured-products.css' | asset_url | stylesheet_tag }}

{%- assign limit = section.settings.products_to_show -%}

<section class="section section--white featured" aria-labelledby="FeaturedHeading-{{ section.id }}">
  <div class="page-width">
    <ns-tabs class="featured__tabs-root">
      <div class="section-head">
        <div>
          {%- if section.settings.eyebrow != blank -%}
            <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}
          <h2 id="FeaturedHeading-{{ section.id }}" class="section-head__title">{{ section.settings.heading | escape }}</h2>
        </div>

        <div class="featured__controls">
          {%- if section.blocks.size > 1 -%}
            <div class="featured__tabs" role="tablist" aria-label="{{ section.settings.heading | escape }}">
              {%- for block in section.blocks -%}
                {%- assign tab_label = block.settings.label | default: block.settings.collection.title | default: section.settings.heading -%}
                <button
                  type="button"
                  role="tab"
                  class="featured__tab"
                  id="Tab-{{ section.id }}-{{ forloop.index }}"
                  aria-controls="Panel-{{ section.id }}-{{ forloop.index }}"
                  aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                  {% unless forloop.first %}
                    tabindex="-1"
                  {% endunless %}
                  {{ block.shopify_attributes }}
                >
                  {{- tab_label | escape -}}
                </button>
              {%- endfor -%}
            </div>
          {%- endif -%}
          {%- if section.settings.link_label != blank -%}
            <a href="{{ section.settings.link | default: routes.all_products_collection_url }}" class="text-link">
              {{ section.settings.link_label | escape }}
              {% render 'icon', name: 'arrow-right' %}
            </a>
          {%- endif -%}
        </div>
      </div>

      {%- for block in section.blocks -%}
        {%- assign collection = block.settings.collection -%}
        <div
          class="featured__panel"
          id="Panel-{{ section.id }}-{{ forloop.index }}"
          {% if section.blocks.size > 1 %}
            role="tabpanel" aria-labelledby="Tab-{{ section.id }}-{{ forloop.index }}"
          {% endif %}
          {% unless forloop.first %}
            data-inactive
          {% endunless %}
        >
          {%- if block.type == 'products' and block.settings.products != blank -%}
            <ul class="product-grid" role="list">
              {%- for product in block.settings.products limit: limit -%}
                <li>{% render 'product-card', product: product, show_quick_add: section.settings.show_quick_add %}</li>
              {%- endfor -%}
            </ul>
          {%- elsif collection != blank and collection.products_count > 0 -%}
            <ul class="product-grid" role="list">
              {%- for product in collection.products limit: limit -%}
                <li>{% render 'product-card', product: product, show_quick_add: section.settings.show_quick_add %}</li>
              {%- endfor -%}
            </ul>
          {%- elsif request.design_mode -%}
            <p class="muted">{{ 'sections.featured.choose_collection' | t }}</p>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </ns-tabs>
  </div>
</section>

{% schema %}
{
  "name": "NS · Featured products",
  "tag": "div",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Atrinkta" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Įranga, kuria pasitikime" },
    { "type": "range", "id": "products_to_show", "label": "Products per tab", "min": 4, "max": 12, "step": 4, "default": 4 },
    { "type": "checkbox", "id": "show_quick_add", "label": "Show add-to-cart button", "default": true },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Visi produktai" },
    { "type": "url", "id": "link", "label": "Link", "info": "Defaults to all products." }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Tab",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "label", "label": "Tab label", "info": "Leave empty to use the collection's name." }
      ]
    },
    {
      "type": "products",
      "name": "Tab with chosen products",
      "settings": [
        { "type": "text", "id": "label", "label": "Tab label", "default": "Rekomenduojame" },
        { "type": "product_list", "id": "products", "label": "Products", "limit": 12 }
      ]
    }
  ],
  "presets": [
    {
      "name": "NS · Featured products",
      "blocks": [
        { "type": "collection", "settings": { "label": "Apšvietimas" } },
        { "type": "collection", "settings": { "label": "Energija ir ryšys" } },
        { "type": "collection", "settings": { "label": "Pirmoji pagalba" } }
      ]
    }
  ]
}
{% endschema %}
