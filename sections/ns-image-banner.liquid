{%- comment -%}
  NorthSurvive · sections/ns-image-banner.liquid
  A large photo banner with text. Three layouts:
  - split: photo on one half, text on the other
  - overlay: full-width photo with the text on top (bottom left)
  Until an editorial photo is uploaded, a product's main image can stand in.
  Use it for visual storytelling between the shopping sections.
{%- endcomment -%}
{%- liquid
  # On page templates this section shows only on the page picked in its settings.
  assign ns_hidden = false
  if template.name == 'page'
    if section.settings.only_page == blank or section.settings.only_page.handle != page.handle
      assign ns_hidden = true
    endif
  endif
-%}
{%- unless ns_hidden -%}
{{ 'section-image-banner.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign banner_image = section.settings.image
  if banner_image == blank and section.settings.fallback_product != blank
    assign banner_image = section.settings.fallback_product.featured_media.preview_image
  endif
  assign focal = banner_image.presentation.focal_point | default: '50% 50%'
  assign focal_style = 'object-position: ' | append: focal
  assign layout = section.settings.layout
-%}

<section
  class="image-banner image-banner--{{ layout }} image-banner--{{ section.settings.color }}{% if section.settings.image_position == 'right' %} image-banner--reverse{% endif %}"
  aria-labelledby="BannerHeading-{{ section.id }}"
>
  <div class="image-banner__media">
    {%- if banner_image != blank -%}
      {{
        banner_image
        | image_url: width: 2400
        | image_tag:
          loading: 'lazy',
          widths: '600, 900, 1200, 1600, 2000, 2400',
          sizes: '(min-width: 900px) 60vw, 100vw',
          alt: banner_image.alt,
          class: 'image-banner__image',
          style: focal_style
      }}
    {%- else -%}
      <div class="image-banner__placeholder" aria-hidden="true"></div>
    {%- endif -%}
  </div>

  <div class="image-banner__content">
    <div class="image-banner__inner">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h2 id="BannerHeading-{{ section.id }}" class="image-banner__heading">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}
        <div class="image-banner__text">{{ section.settings.text }}</div>
      {%- endif -%}
      {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
        <a href="{{ section.settings.button_link }}" class="button{% if section.settings.color == 'graphite' or layout == 'overlay' %} button--light{% endif %}">
          {{ section.settings.button_label | escape }}
          {% render 'icon', name: 'arrow-right' %}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{%- endunless -%}

{% schema %}
{
  "name": "NS · Image banner",
  "tag": "div",
  "settings": [
    { "type": "page", "id": "only_page", "label": "Show on page", "info": "Only used on page templates, e.g. \"Apie mus\". Empty there: the section is hidden." },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Editorial photo, at least 1600 px wide." },
    {
      "type": "product",
      "id": "fallback_product",
      "label": "Product photo until the image is ready",
      "info": "Its main image is used when no image is set above."
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "split", "label": "Photo and text side by side" },
        { "value": "overlay", "label": "Text over a full-width photo" }
      ],
      "default": "split"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Photo position (side by side)",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "color",
      "label": "Text background",
      "options": [
        { "value": "paper", "label": "Paper" },
        { "value": "white", "label": "White" },
        { "value": "graphite", "label": "Graphite" }
      ],
      "default": "white"
    },
    { "type": "text", "id": "eyebrow", "label": "Small label" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Antraštė" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "NS · Image banner" }]
}
{% endschema %}
