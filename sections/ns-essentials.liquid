{%- comment -%}
  NorthSurvive · sections/ns-essentials.liquid
  "The Four Essentials": an asymmetric category grid. The first tile is tall,
  the last one wide. Each tile links to a real collection and shows its live
  product count. Image: the block image, or the collection's own image.
  On phones the tiles become a horizontal swipe rail.
{%- endcomment -%}
{{ 'section-essentials.css' | asset_url | stylesheet_tag }}

<section class="section essentials" aria-labelledby="EssentialsHeading-{{ section.id }}">
  <div class="page-width">
    <div class="section-head">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.main_heading -%}
          <h1 id="EssentialsHeading-{{ section.id }}" class="section-head__title">{{ section.settings.heading | escape }}</h1>
        {%- else -%}
          <h2 id="EssentialsHeading-{{ section.id }}" class="section-head__title">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
      </div>
      {%- if section.settings.text != blank -%}
        <p class="section-head__text">{{ section.settings.text | escape }}</p>
      {%- endif -%}
    </div>

    <div class="essentials__grid {% if section.settings.layout == 'editorial' %}essentials__grid--{{ section.blocks.size }}{% else %}essentials__grid--row{% endif %}">
      {%- for block in section.blocks -%}
        {%- liquid
          assign collection = block.settings.collection
          assign tile_image = block.settings.image | default: collection.featured_image
          assign tile_title = block.settings.title | default: collection.title
          if forloop.first
            assign sizes = '(min-width: 900px) 50vw, 80vw'
          else
            assign sizes = '(min-width: 900px) 25vw, 80vw'
          endif
        -%}
        <a
          href="{{ collection.url | default: routes.all_products_collection_url }}"
          class="essentials__tile"
          {{ block.shopify_attributes }}
        >
          <div class="essentials__media">
            {%- if tile_image != blank -%}
              {{
                tile_image
                | image_url: width: 1600
                | image_tag:
                  loading: 'lazy',
                  widths: '400, 600, 800, 1200, 1600',
                  sizes: sizes,
                  alt: '',
                  class: 'essentials__image'
              }}
            {%- else -%}
              <div class="essentials__placeholder"></div>
            {%- endif -%}
          </div>
          <div class="essentials__body">
            <div>
              {%- if block.settings.label != blank -%}
                <p class="eyebrow essentials__label">{{ block.settings.label | escape }}</p>
              {%- endif -%}
              {%- if section.settings.main_heading -%}<h2 class="essentials__title">{{ tile_title | escape }}</h2>{%- else -%}<h3 class="essentials__title">{{ tile_title | escape }}</h3>{%- endif -%}
              {%- if collection != blank and section.settings.show_count -%}
                <p class="essentials__count">{{ 'collections.products_count' | t: count: collection.products_count }}</p>
              {%- endif -%}
            </div>
            <span class="essentials__arrow" aria-hidden="true">{% render 'icon', name: 'arrow-right' %}</span>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "NS · Categories",
  "tag": "div",
  "max_blocks": 8,
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "row", "label": "Even row (works for any number of categories)" },
        { "value": "editorial", "label": "Editorial (best with exactly 4)" }
      ],
      "default": "row"
    },
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Produktai" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Pirkite pagal kategoriją" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "checkbox", "id": "show_count", "label": "Show product count", "default": true },
    {
      "type": "checkbox",
      "id": "main_heading",
      "label": "Use as the page's main heading (H1)",
      "info": "Turn on only when this is the first section of a page, such as the categories page.",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "label", "label": "Small label", "info": "Optional, for example a short note above the title." },
        { "type": "text", "id": "title", "label": "Title", "info": "Leave empty to use the collection's name." },
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Leave empty to use the collection's image. Lifestyle photos work best." }
      ]
    }
  ],
  "presets": [
    {
      "name": "NS · Categories",
      "settings": { "layout": "row" },
      "blocks": [
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" }
      ]
    }
  ]
}
{% endschema %}
