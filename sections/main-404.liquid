{%- comment -%} NorthSurvive · sections/main-404.liquid — "page not found". All text is editable in the theme editor. {%- endcomment -%}
<section class="section page-width" style="display: grid; gap: var(--space-5); justify-items: start;">
  {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
  <h1>{{ section.settings.heading | escape }}</h1>
  {%- if section.settings.text != blank -%}<div class="lead rte">{{ section.settings.text }}</div>{%- endif -%}
  {%- if section.settings.button_label != blank -%}
    <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="button">
      {{ section.settings.button_label | escape }}
      {% render 'icon', name: 'arrow-right' %}
    </a>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "404 page",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "404" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Šio puslapio nėra." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Galbūt nuoroda pasikeitė arba puslapis buvo perkeltas. Pradėkite nuo produktų arba grįžkite į pradžią.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Žiūrėti produktus" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ]
}
{% endschema %}
